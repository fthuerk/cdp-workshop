# Copy to config.env and adjust for your cluster.
# Source from scripts: source "$(dirname "$0")/../config.env" or use lib/common.sh

# HDFS workshop root (shared read-only data and module paths)
WORKSHOP_ROOT=/2026_cdp_workshop

# Path to this repo on the edge node (for bootstrap uploads)
WORKSHOP_LOCAL=/opt/cdp-workshop

# Oozie server URL (module 08: setup/verify.sh and lab check.sh), e.g. https://oozie.example:11443/oozie
OOZIE_URL=http://localhost:11000/oozie

# Livy for Spark 3 behind Knox (module 09: setup/verify.sh); participants get this URL in the handout.
# Example for a CDP Private Cloud Base cluster; Knox authenticates workshop users against LDAP (HTTP Basic).
LIVY_URL=https://knox.example:8443/gateway/cdp-proxy-api/livy_for_spark3
# Optional CA bundle (PEM) when the Knox certificate is signed by an internal CA
# LIVY_CACERT=/etc/pki/tls/certs/internal-ca.pem

# Ranger (optional; for apply_policies.sh)
RANGER_URL=https://ranger.example:6182
RANGER_HDFS_SERVICE=cm_hdfs
# Hive service name in Ranger UI (module I1 trainer policies)
RANGER_HIVE_SERVICE=cm_hive
RANGER_USER=admin
# RANGER_PASSWORD=set-in-config.env-not-in-git

# HDFS replication factor for demos (cluster default is often 3)
WORKSHOP_REPLICATION=3

# Workshop Linux group for shared writable dirs (optional)
WORKSHOP_GROUP=workshop
