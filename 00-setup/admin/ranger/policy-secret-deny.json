{
  "name": "cdp-workshop-hdfs-deny-secret",
  "description": "Deny read on HDFS module secret path",
  "isEnabled": true,
  "resources": {
    "path": {
      "values": ["/2026_cdp_workshop/02-hdfs/secret/*"],
      "isExcludes": false,
      "isRecursive": true
    }
  },
  "policyItems": [],
  "denyPolicyItems": [
    {
      "accesses": [{ "type": "read", "isAllowed": true }],
      "users": ["{USER}"],
      "groups": [],
      "delegateAdmin": false
    }
  ],
  "service": "cm_hdfs"
}
